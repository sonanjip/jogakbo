<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged into every client app: lets it see and bind to Jogakbo (Android 11+ package visibility). -->
    <queries>
        <package android:name="io.github.taehunkim.jogakbo" />
    </queries>
    <application>
        <!-- "Notes changed" hints from Jogakbo; exported because Jogakbo is another app. -->
        <receiver
            android:name="io.github.taehunkim.jogakbo.sdk.NotesChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.taehunkim.jogakbo.action.NOTES_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
